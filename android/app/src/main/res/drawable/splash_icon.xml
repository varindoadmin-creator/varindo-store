<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash screen shown while the TWA loads: the Varindo mark centred on the
    white canvas.

    The mark is tinted ink here because @mipmap/ic_launcher_foreground is drawn
    in pure white — it was made for the launcher icon's dark ink background, and
    on this white splash it would otherwise be invisible.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background -->
    <item>
        <color android:color="@color/splashScreenBackground" />
    </item>
    <!-- Centered logo mark — the app icon's foreground mark, tinted ink -->
    <item
        android:gravity="center"
        android:width="96dp"
        android:height="96dp">
        <bitmap
            android:src="@mipmap/ic_launcher_foreground"
            android:gravity="center"
            android:tint="@color/colorPrimary" />
    </item>
</layer-list>
