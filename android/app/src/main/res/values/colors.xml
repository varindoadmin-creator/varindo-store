<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The site is a white canvas with ink text and has no dark theme
        (globals.css pins color-scheme: light), so the system bars are white in
        both colour schemes and their icons are drawn dark.

        Dark icons need windowLightStatusBar (API 23+) and
        windowLightNavigationBar (API 27+), which is why Theme.VarindoSplash is
        split across values/, values-v23/, values-v27/ and values-v31/ — API
        21–22 has no way to darken bar icons, so it keeps ink bars. Inside the
        Trusted Web Activity, Chrome derives the icon tint from the colour's own
        luminance, so the white bars there need no extra flag.
    -->

    <!-- Brand ink — Material's colorPrimary, and the API 21–22 bar colour.
         colorAccent is the logo tone the web UI uses for interactive surfaces. -->
    <color name="colorPrimary">#1d1d1f</color>
    <color name="colorPrimaryDark">#1d1d1f</color>
    <color name="colorAccent">#282828</color>

    <!-- System bars -->
    <color name="statusBarColor">#ffffff</color>
    <color name="navigationColor">#ffffff</color>
    <color name="navigationDividerColor">#d6d6d6</color>

    <!-- Splash screen background — matches the site's white canvas -->
    <color name="splashScreenBackground">#ffffff</color>
</resources>
