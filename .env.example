# Public WhatsApp number in international format without +
NEXT_PUBLIC_VARINDO_WHATSAPP=6281210015224

# Public catalog prices are the catalogue CSV rate + PPN.
NEXT_PUBLIC_PPN_RATE=0.11

# Anthropic API key for the AI chat assistant
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# VIABooks (via-corporate) — where Sample and Catalogue requests are stored.
# VIABOOKS_ORGANIZATION_ID is CV. Varindo Forma Hutama's org id in VIABooks.
VIABOOKS_API_URL=https://viabooks-601025884976.asia-southeast2.run.app
VIABOOKS_ORGANIZATION_ID=cmtn75jst0001w12y30bcrr6h

# SMTP — for email notifications on new requests (Google Workspace)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=contact@varindo.co.id
SMTP_PASS=your-google-app-password-here

# Midtrans — online payment for cart checkout. Server key from the Midtrans
# dashboard (Settings → Access Keys). Sandbox keys start with SB-; set
# MIDTRANS_IS_PRODUCTION=true only together with the production key.
MIDTRANS_SERVER_KEY=SB-Mid-server-your-key-here
# MIDTRANS_IS_PRODUCTION=true

# Private bucket holding one JSON file per order. Required in production;
# leave unset locally and orders are written to .data/orders.
# ORDERS_BUCKET=varindo-store-orders

# Public address of the store, used for Midtrans' return and notification
# URLs. Defaults to the address the request came in on.
# STORE_URL=https://store.varindo.co.id

# Google Maps — address search at checkout (Places API (New)). Server-side
# only; restrict the key to the Places API. Leave unset and checkout just
# has the plain address fields.
# GOOGLE_MAPS_API_KEY=your-google-maps-key

# Lalamove — staff book delivery from the paid-order email. Varindo pays;
# buyers never see the price. Sandbox until LALAMOVE_IS_PRODUCTION=true.
# LALAMOVE_API_KEY=pk_test_...
# LALAMOVE_API_SECRET=sk_test_...
# LALAMOVE_IS_PRODUCTION=true
# The warehouse every trip starts from.
# LALAMOVE_PICKUP_NAME=Varindo
# LALAMOVE_PICKUP_PHONE=081210015224
# LALAMOVE_PICKUP_ADDRESS=Full warehouse address
# LALAMOVE_PICKUP_LAT=-6.30
# LALAMOVE_PICKUP_LNG=106.65

# Signs the staff order links in paid-order emails (at least 16 characters).
# STAFF_LINK_SECRET=a-long-random-string
